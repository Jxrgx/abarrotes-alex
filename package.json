    "test:e2e:states": "node --env-file=.env.local tests/e2e/states.mjs",
    "test:e2e:dialogs": "node --env-file=.env.local tests/e2e/admin-dialogs.mjs",
    "test:e2e:orders": "node --env-file=.env.local tests/e2e/orders.mjs",
    "test:e2e:promotions": "node --env-file=.env.local tests/e2e/promotions.mjs",
